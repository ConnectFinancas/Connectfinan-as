# Copie este arquivo pra .env.local e preencha com os valores do seu projeto Supabase
# (Project Settings > API Keys no painel do Supabase). NUNCA coloque a service_role key
# aqui nem em nenhum arquivo commitado — ela só existe como variável de ambiente no servidor
# (Vercel), e mesmo assim só quando for estritamente necessária.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
